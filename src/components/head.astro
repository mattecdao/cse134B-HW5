---
import siteData from '../data/site.json';
import '../styles/index.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = "Native web component widgets built with Astro." } = Astro.props;
const pageTitle = title ? `${title} | ${siteData.title}` : siteData.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "http://localhost:4321");
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="light dark">
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
